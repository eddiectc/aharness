#!/usr/bin/env bash
# Run aharness inside a bubblewrap sandbox: minimal read-only root, most of
# $HOME hidden, the project and the aharness state directory writable. The host
# network is shared, so this is a filesystem and process boundary, not a
# network one.
set -eu

PROJECT="${AHARNESS_BWRAP_PROJECT:-$PWD}"
while [ $# -gt 0 ]; do
  case "$1" in
    --project)
      [ $# -ge 2 ] || { echo "aharness-bwrap: --project needs a directory" >&2; exit 2; }
      PROJECT="$2"; shift 2 ;;
    --project=*) PROJECT="${1#--project=}"; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if ! resolved="$(cd "$PROJECT" 2>/dev/null && pwd -P)"; then
  echo "aharness-bwrap: project directory does not exist: $PROJECT" >&2
  exit 1
fi
PROJECT="$resolved"

# Binding $HOME, an ancestor of $HOME, or / would expose the whole home
# directory. pwd -P above resolves symlinks, so a symlinked project path cannot
# smuggle one of them through.
refuse() {
  echo "aharness-bwrap: refusing to sandbox $PROJECT ($1); cd into a project dir or pass --project <dir>" >&2
  exit 1
}
[ "$PROJECT" != "/" ] || refuse "the filesystem root"
case "$HOME/" in
  "$PROJECT"/*) refuse "it contains \$HOME" ;;
esac

# aharness writes durable session logs under ~/.aharness. Create it before the
# bind: a hard --bind fails outright when the source is missing, and a
# --bind-try would put the logs in the throwaway sandbox root instead.
command -v bwrap >/dev/null 2>&1 || {
  echo "aharness-bwrap: bwrap not found; install bubblewrap" >&2
  exit 1
}
STATE_DIR="$HOME/.aharness"
mkdir -p "$STATE_DIR"

# Extra host paths to bind read-write, space-separated. This sample preconfigures
# Go; add another ecosystem's toolchain here instead of editing the list below.
# Only paths inside $HOME need this: anything under /usr is already bound.
#   AHARNESS_BWRAP_BIND="$HOME/.cargo $HOME/.rustup"        # rustup/cargo
#   AHARNESS_BWRAP_BIND="$HOME/.nvm"                        # node via nvm
#   AHARNESS_BWRAP_BIND="$HOME/.pyenv"                      # pyenv
#   AHARNESS_BWRAP_BIND="$HOME/.cache/go-build"             # warm Go build cache
# Paths must be absolute and contain no spaces.
EXTRA_BINDS=()
for dir in ${AHARNESS_BWRAP_BIND:-}; do
  case "$dir" in
    /*) ;;
    *) echo "aharness-bwrap: AHARNESS_BWRAP_BIND paths must be absolute: $dir" >&2; exit 1 ;;
  esac
  [ -d "$dir" ] || {
    echo "aharness-bwrap: AHARNESS_BWRAP_BIND path is not a directory: $dir" >&2
    exit 1
  }
  EXTRA_BINDS+=(--bind "$dir" "$dir")
done

BWRAP_ARGS=(
  --unshare-all
  --share-net
  --die-with-parent
  --ro-bind /usr /usr
  --ro-bind /etc /etc
  --ro-bind-try /opt /opt
  --ro-bind-try /run/systemd/resolve /run/systemd/resolve
  --symlink usr/bin /bin
  --symlink usr/lib /lib
  --symlink usr/lib64 /lib64
  --symlink usr/sbin /sbin
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  --dir "$HOME/.cache"
  --bind "$STATE_DIR" "$STATE_DIR"
  --bind-try "$HOME/go/pkg" "$HOME/go/pkg"
  "${EXTRA_BINDS[@]}"
  --ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig"
  --ro-bind-try "$HOME/.local/bin" "$HOME/.local/bin"
  --ro-bind-try "$HOME/go/bin" "$HOME/go/bin"
  --ro-bind-try "$HOME/.agents" "$HOME/.agents"
  --bind "$PROJECT" "$PROJECT"
  --chdir "$PROJECT"
)

if [ "${1:-}" = "--shell" ]; then
  shift
  exec bwrap "${BWRAP_ARGS[@]}" -- /usr/bin/sh "$@"
fi

command -v aharness >/dev/null 2>&1 || {
  echo "aharness-bwrap: aharness not found in PATH; run 'make install' first" >&2
  exit 1
}

exec bwrap "${BWRAP_ARGS[@]}" -- aharness "$@"
